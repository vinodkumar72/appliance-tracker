{
  "expo": {
    "name": "PropsLane",
    "slug": "appliance-tracker",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "appliancetracker",
    "userInterfaceStyle": "automatic",
    "ios": {
      "bundleIdentifier": "com.suvanc.appliancetracker",
      "supportsTablet": true
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#2158E0",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "output": "single",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#2158E0",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 96
        }
      ],
      "@react-native-community/datetimepicker",
      [
        "expo-image-picker",
        {
          "cameraPermission": "PropsLane uses the camera to scan appliance labels so records fill in automatically.",
          "photosPermission": "PropsLane uses your photo library so you can pick a photo of an appliance label to scan."
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    }
  }
}
