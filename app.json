{
  "expo": {
    "name": "PropsLane",
    "slug": "appliance-tracker",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "appliancetracker",
    "userInterfaceStyle": "automatic",
    "ios": {
      "bundleIdentifier": "com.propslane.appliancetracker",
      "supportsTablet": true,
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "package": "com.propslane.appliancetracker",
      "adaptiveIcon": {
        "backgroundColor": "#2158E0",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "permissions": [
        "android.permission.RECORD_AUDIO"
      ]
    },
    "web": {
      "output": "single",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#2158E0",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 96
        }
      ],
      "@react-native-community/datetimepicker",
      [
        "expo-image-picker",
        {
          "cameraPermission": "PropsLane uses the camera to scan appliance labels so records fill in automatically.",
          "photosPermission": "PropsLane uses your photo library so you can pick a photo of an appliance label to scan."
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "ec6dd220-6fe1-4ccf-9aaf-759c1a32b1d5"
      }
    }
  }
}
